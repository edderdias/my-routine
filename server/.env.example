# Firebase Admin - JSON da service account codificado em base64
# (Console do Firebase > Configuracoes do projeto > Contas de servico > Gerar nova chave privada)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Alternativa: cole o JSON puro (uma linha) em vez de base64
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Mesmo valor de firestoreDatabaseId em firebase-applet-config.json
FIRESTORE_DATABASE_ID=ai-studio-minharotina-b58d073f-0b7f-4a5b-8026-5208672588c4

# Meta WhatsApp Cloud API (developers.facebook.com)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Resend (resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Minha Rotina <onboarding@resend.dev>

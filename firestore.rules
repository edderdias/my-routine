rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Root test connection doc for validation
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // User profile and private subcollections
    match /users/{userId} {
      allow get, update: if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if false;

      // User tasks
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      // User categories
      match /categories/{categoryId} {
        allow read, write: if isOwner(userId);
      }

      // User professional work types (custom + defaults)
      match /workTypes/{workTypeId} {
        allow read, write: if isOwner(userId);
      }

      // User notification logs
      match /logs/{logId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
